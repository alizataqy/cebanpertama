# Tips Docker Compose: Jangan gunakan tanda kutip ganda ("") pada value URL/secret agar Docker tidak membacanya sebagai string kutip literal.

# Database (Gunakan PostgreSQL luar / host lokal / cloud provider)
# - Dari dalam Docker ke host: host.docker.internal:5432
# - Langsung tanpa Docker: localhost:5432
DATABASE_URL=postgresql://root:root@host.docker.internal:5432/spitbill_db?schema=public

# App
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Better Auth & App Configuration (Ganti ke domain production jika live)
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Configuration (Optional - leave empty for console dev mode)
RESEND_API_KEY=""
EMAIL_FROM="Ceban Pertama <onboarding@resend.dev>"

# Google OAuth Configuration (Optional - for Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
